5. urban/views.py
This provides the REST APIs and dashboard.
from django.shortcuts import render
from rest_framework.decorators import api_view
from rest_framework.response import Response

from .models import UrbanData, Complaint
from .serializers import UrbanDataSerializer, ComplaintSerializer


def dashboard(request):
    data = UrbanData.objects.all()

    context = {
        "data": data,
        "total_complaints": Complaint.objects.count(),
    }

    return render(request, "dashboard.html", context)


@api_view(['GET'])
def urban_data(request):

    data = UrbanData.objects.all()
    serializer = UrbanDataSerializer(data, many=True)

    return Response(serializer.data)


@api_view(['POST'])
def add_complaint(request):

    serializer = ComplaintSerializer(data=request.data)

    if serializer.is_valid():
        serializer.save()
        return Response({
            "message": "Complaint submitted successfully",
            "data": serializer.data
        })

    return Response(serializer.errors, status=400)


@api_view(['GET'])
def complaints(request):

    data = Complaint.objects.all()
    serializer = ComplaintSerializer(data, many=True)

    return Response(serializer.data)
